{
  "name": "@browserid-ng/nextauth",
  "version": "0.2.0",
  "description": "Drop-in 'Sign in with BrowserID' for Auth.js / NextAuth: a Credentials provider that verifies a BrowserID presentation server-side, plus browser helpers to drive the login dialog.",
  "type": "module",
  "main": "./index.mjs",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs"
    },
    "./client": {
      "types": "./client.d.ts",
      "import": "./client.mjs"
    }
  },
  "files": [
    "index.mjs",
    "index.d.ts",
    "client.mjs",
    "client.d.ts",
    "README.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@browserid-ng/verify": "^0.3.0"
  },
  "peerDependencies": {
    "next-auth": ">=4"
  },
  "peerDependenciesMeta": {
    "next-auth": {
      "optional": true
    }
  },
  "keywords": [
    "browserid",
    "nextauth",
    "auth.js",
    "authentication",
    "credentials-provider",
    "sign-in"
  ],
  "license": "MPL-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/vthunder/browserid-ng"
  }
}
