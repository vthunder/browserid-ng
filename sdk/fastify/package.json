{
  "name": "@browserid-ng/fastify",
  "version": "0.2.1",
  "description": "Sign in with BrowserID for Fastify: a preHandler hook that verifies a BrowserID presentation server-side.",
  "type": "module",
  "main": "./index.mjs",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs"
